{
  "name": "dsh-model-context-catalog",
  "version": "0.3.0",
  "description": "Maintain deployment-specific context windows for custom DeepSeek Harness model routes.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./catalog": "./lib/catalog.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "ROOT_CAUSE.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "check": "npm run build && npm run verify:bundle && npm run lint",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run check && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Model Context Catalog",
    "summary": "为自定义模型与中转站路由集中维护上下文窗口，并同步到 DSH 模型配置。",
    "categories": [
      "模型",
      "Web UI",
      "配置"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0-0",
      "node": ">=22"
    },
    "permissions": {
      "network": []
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context-window",
    "model-metadata",
    "web-ui"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": "~0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "~0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "~0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "~0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "~0.2.0-rc.2",
    "react": "^18.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HOWILLMAKEIT/dsh-model-context-catalog.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cosmokit": "1.8.5",
    "react-test-renderer": "^18.3.1"
  }
}
