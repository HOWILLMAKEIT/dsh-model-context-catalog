{
  "name": "dsh-model-context-catalog",
  "version": "0.2.0",
  "description": "Context-window metadata catalog and settings UI for configured DeepSeek Harness model routes.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./catalog": "./lib/catalog.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "ROOT_CAUSE.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "check": "npm run build && npm run verify:bundle && npm run lint",
    "test": "npm run build && node --test",
    "prepack": "npm run check && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Model Context Catalog",
    "summary": "维护模型上下文窗口目录，自动修正 llm-pi-ai 元数据，并提供原生 Web 设置页面。",
    "categories": ["模型", "Web UI", "配置"],
    "surfaces": ["host", "web"],
    "compatibility": {
      "dsh": ">=0.1.1-rc.2",
      "node": ">=22"
    },
    "permissions": {
      "network": []
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context-window",
    "model-metadata",
    "web-ui"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "react": "^18.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HOWILLMAKEIT/dsh-model-context-catalog.git"
  },
  "license": "MIT"
}
