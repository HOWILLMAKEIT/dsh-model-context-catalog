{
  "name": "dsh-model-context-catalog",
  "version": "0.4.1",
  "description": "One-click context window matching and selective bulk configuration for DeepSeek Harness models, with source references and manual management.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./catalog": "./lib/catalog.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "check": "npm run build && npm run verify:bundle && npm run lint && npm run format:check",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run check && npm test",
    "format": "prettier --write src scripts test",
    "format:check": "prettier --check src scripts test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Model Context Catalog",
    "summary": "一键匹配已配置模型的上下文窗口，展示容量来源；支持勾选批量配置、已有窗口管理和手动编辑。",
    "categories": [
      "\u6a21\u578b",
      "Web UI",
      "\u914d\u7f6e"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0-0",
      "node": ">=22"
    },
    "permissions": {
      "network": []
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context-window",
    "model-metadata",
    "web-ui"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-remotes": "~0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "~0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "~0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "~0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "~0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "~0.2.0-rc.2",
    "react": "^18.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HOWILLMAKEIT/dsh-model-context-catalog.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cosmokit": "1.8.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "react-test-renderer": "^18.3.1"
  }
}
